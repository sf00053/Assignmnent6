<Window x:Class="Assignment6.Views.AltMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment6.Views"
        mc:Ignorable="d"
        Title="People Database - List View" Height="600" Width="560"
        MinHeight="520" MinWidth="480">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="People" FontSize="28" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Margin="0,0,0,10"
                   Text="Select a person to edit their details. Save to keep your changes."/>

        <Label Grid.Row="2" Content="S_earch" Target="{Binding ElementName=SearchTextBox}"/>
        <TextBox x:Name="SearchTextBox" Grid.Row="3" TabIndex="0" Height="28"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <DockPanel Grid.Row="4" Margin="0,12,0,12">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                       Text="{Binding SortDescription, Mode=OneWay}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Sort by _Name" TabIndex="1" Padding="14,6"
                        Margin="0,0,10,0" Command="{Binding SortByNameCommand}"/>
                <Button Content="S_ort by Age" TabIndex="2" Padding="14,6"
                        Command="{Binding SortByAgeCommand}"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="PeopleListBox" Grid.Row="5" TabIndex="3"
                 ItemsSource="{Binding People}"
                 SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                 DisplayMemberPath="FullName"
                 SelectionMode="Single"/>

        <GroupBox Grid.Row="6" Header="Selected Person" Margin="0,15,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="_First Name" Target="{Binding ElementName=FirstNameTextBox}"/>
                    <TextBox x:Name="FirstNameTextBox" TabIndex="4" Height="26"
                             VerticalContentAlignment="Center"
                             Text="{Binding SelectedPerson.FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <Label Content="_Last Name" Target="{Binding ElementName=LastNameTextBox}"/>
                    <TextBox x:Name="LastNameTextBox" TabIndex="5" Height="26"
                             VerticalContentAlignment="Center"
                             Text="{Binding SelectedPerson.LastName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="A_ge" Target="{Binding ElementName=AgeTextBox}"/>
                    <TextBox x:Name="AgeTextBox" TabIndex="6" Height="26"
                             VerticalContentAlignment="Center"
                             Text="{Binding SelectedPerson.Age, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,15,0,10">
            <Button Content="_Add Person" TabIndex="7" Padding="16,6"
                    Margin="0,0,10,0" Command="{Binding AddPersonCommand}"/>
            <Button Content="_Delete Person" TabIndex="8" Padding="16,6"
                    Margin="0,0,10,0" Command="{Binding DeletePersonCommand}"/>
            <Button Content="_Save Changes" TabIndex="9" Padding="16,6"
                    Command="{Binding SaveChangesCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="8" Text="{Binding StatusMessage}"/>
    </Grid>
</Window>